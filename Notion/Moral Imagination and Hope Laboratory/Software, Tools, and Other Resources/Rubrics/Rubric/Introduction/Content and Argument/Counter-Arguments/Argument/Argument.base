# Argument

filters:
  and:
    - note["base"] == link("Argument.base")
properties:
  file.name:
    displayName: Name
  Unacceptable:
    displayName: Unacceptable
  Excellent:
    displayName: Excellent
  Good:
    displayName: Good
  Needs Improvement:
    displayName: Needs Improvement
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Unacceptable
      - Excellent
      - Good
      - Needs Improvement
