# Rubric

filters:
  and:
    - note["base"] == link("Rubric.base")
properties:
  file.name:
    displayName: Name
  Blocked by:
    displayName: Blocked by
  Date:
    displayName: Date
  1/4 Points:
    displayName: 1/4 Points
  1/2 Points:
    displayName: 1/2 Points
  Full Points:
    displayName: Full Points
  Blocking:
    displayName: Blocking
  3/4 Points:
    displayName: 3/4 Points
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Blocked by
      - Date
      - 1/4 Points
      - 1/2 Points
      - Full Points
      - Blocking
      - 3/4 Points
