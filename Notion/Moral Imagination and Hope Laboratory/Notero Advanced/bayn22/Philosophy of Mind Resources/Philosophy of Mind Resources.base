# Philosophy of Mind Resources

filters:
  and:
    - note["base"] == link("Philosophy of Mind Resources.base")
properties:
  file.name:
    displayName: Sections
  PhilPapers:
    displayName: PhilPapers
  Summary:
    displayName: Summary
  Primary Sources:
    displayName: Primary Sources
  Secondary Sources:
    displayName: Secondary Sources
  PhilPapers Secondary:
    displayName: PhilPapers Secondary
views:
  - type: table
    name: Table View
    order:
      - file.name
      - PhilPapers
      - Summary
      - Primary Sources
      - Secondary Sources
      - PhilPapers Secondary
