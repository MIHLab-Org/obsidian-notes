# Class Discussion Notes

filters:
  and:
    - note["base"] == link("Class Discussion Notes.base")
properties:
  file.name:
    displayName: Name
  Tags:
    displayName: Tags
  Subject:
    displayName: Subject
  Column:
    displayName: Column
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tags
      - Subject
      - Column
